# Parámetros de despliegue del ambiente dev (los lee scripts/canary_deploy.sh)
AEGIS_ENV=dev
# 4 stable + 1 canary = 20 % del tráfico hacia la versión nueva.
STABLE_REPLICAS=4
CANARY_REPLICAS=1
# Floci visto desde los pods. CoreDNS no resuelve los nombres de Docker ("floci"), así que se usa
# la IP de Floci dentro de la red de la VPC del ambiente (base del CIDR + 2): el tráfico a DynamoDB y
# CloudWatch no sale de la VPC. Respaldo: http://192.168.65.254:4566 (host de Docker Desktop).
K8S_AWS_ENDPOINT=http://10.10.0.2:4566
SURGE_FORCE_PEAK=true
# Umbrales del análisis canary
CANARY_ANALYSIS_ROUNDS=3
CANARY_ANALYSIS_INTERVAL=${CANARY_ANALYSIS_INTERVAL_OVERRIDE:-20}
CANARY_PROBES_PER_ROUND=40
CANARY_MAX_ERRORS=0
CANARY_MIN_TRAFFIC_PCT=5
CANARY_MAX_TRAFFIC_PCT=40
